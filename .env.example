# Password visitors type to unlock the résumé PDFs.
RESUME_PASSWORD=
# Long random string used to sign the résumé cookie and the contact captcha.
# Generate one with: openssl rand -hex 32
SITE_SECRET=
# Contact form email delivery via https://resend.com (free tier is enough).
RESEND_API_KEY=
# Optional: where messages go (defaults to lisboaphe@gmail.com) and the sender.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Private storage URLs of the résumé PDFs (e.g. Vercel Blob). Never commit the PDFs.
# Locally you can leave these empty and put the files in private/cv/ instead.
RESUME_PDF_URL_EN=
RESUME_PDF_URL_DE=
